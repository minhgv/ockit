{
	"$schema": "https://opencode.ai/config.json",
	"lsp": false,
	"autoupdate": false,
	"share": "manual",
	"agent": {
		"orchestrator": {
			"description": "Master Pipeline Orchestrator & SDLC State Manager for ockit",
			"model": "opencode-go/deepseek-v4-flash"
		},
		"planner": {
			"description": "Lead System Architect & BA Specialist for ockit",
			"model": "opencode-go/deepseek-v4-flash"
		},
		"coder": {
			"description": "Senior TDD Developer (RED-GREEN-REFACTOR)",
			"model": "opencode-go/deepseek-v4-flash"
		},
		"reviewer": {
			"description": "Principal Security & Quality Auditor",
			"model": "opencode-go/deepseek-v4-flash"
		},
		"qa": {
			"description": "E2E QA Automation & Chaos Engineer",
			"model": "opencode-go/deepseek-v4-flash"
		}
	},
	"compaction": {
		"auto": true,
		"reserved": 2048
	},
	"formatter": {
		"biome": {
			"command": ["npx", "@biomejs/biome", "check", "--write", "$FILE"],
			"extensions": [".js", ".jsx", ".ts", ".tsx", ".json", ".jsonc"]
		}
	},
	"permission": {
		"bash": {
			"*": "allow",
			"cat *": "allow",
			"git branch *": "allow",
			"git checkout *": "ask",
			"git clean *": "ask",
			"git commit *": "ask",
			"git diff *": "allow",
			"git log *": "allow",
			"git merge *": "ask",
			"git push *": "ask",
			"git rebase *": "ask",
			"git reset *": "ask",
			"git status *": "allow",
			"ls *": "allow",
			"npm *": "allow",
			"npm publish *": "ask",
			"npm run db:push*": "ask",
			"npm run db:reset*": "deny",
			"npx *": "allow",
			"rm *": "deny",
			"rm -rf *": "deny",
			"sudo *": "deny"
		},
		"doom_loop": "ask",
		"edit": "allow",
		"external_directory": {
			"*": "ask"
		},
		"question": "allow",
		"read": {
			"*": "allow",
			"*.env": "deny",
			"*.env.*": "deny",
			"*.env.example": "allow",
			"*.key": "deny",
			"*.pem": "deny",
			"*credentials*": "deny",
			"*password*": "deny",
			"*secret*": "deny",
			"*token*": "deny"
		}
	},
	"plugin": [
		"./plugin/ockit-quality-gate.js",
		"./plugin/ockit-ba-traceability.js",
		"./plugin/ockit-tdd-runner.js",
		"./plugin/ockit-linter-fixer.js"
	],
	"watcher": {
		"ignore": [
			"node_modules/**",
			".git/**",
			"dist/**",
			"build/**",
			"*.log",
			".DS_Store"
		]
	}
}
